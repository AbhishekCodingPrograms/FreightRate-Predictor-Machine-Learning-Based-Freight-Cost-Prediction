# FreightRate Predictor - Production Environment Configuration

# Backend API Settings
API_ENV=production
LOG_LEVEL=INFO
SERVICE_NAME=freight-rate-predictor
VERSION=1.0.0
PORT=8000
HOST=0.0.0.0

# Model Artifact Settings
MODEL_ARTIFACT_PATH=artifacts/freight_rate_model.joblib
MAX_BATCH_SIZE=1000

# Security & CORS (Production: specify exact allowed origin domains)
CORS_ORIGINS=["http://localhost:3000","http://localhost","https://freight.example.com"]

# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=freight_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres_secure_password_change_me@db:5432/freight_db
TEST_DATABASE_URL=sqlite:///:memory:
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Next.js Frontend Settings
NEXT_PUBLIC_API_URL=/api/v1
