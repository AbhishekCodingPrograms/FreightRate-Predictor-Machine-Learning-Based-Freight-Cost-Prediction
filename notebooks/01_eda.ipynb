   "source": [
    "# Freight Rate Predictor: Exploratory Data Analysis (EDA)\n",
    "**Author:** ML Engineering Team  \n",
    "**Objective:** Explore data distributions, feature relationships, missing value patterns, seasonal freight rate trends, and domain-specific signal interactions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Add project root to sys.path\n",
    "BASE_DIR = Path.cwd().parent if Path.cwd().name == 'notebooks' else Path.cwd()\n",
    "if str(BASE_DIR) not in sys.path:\n",
    "    sys.path.insert(0, str(BASE_DIR))\n",
    "\n",
    "from src import data_loader, preprocessing, features\n",
    "print('Loaded workspace base path:', BASE_DIR)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data Loading & Initial Inspection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "train_df = data_loader.load_train_data(BASE_DIR / 'data' / 'train-test.csv')\n",
    "val_df = data_loader.load_validation_data(BASE_DIR / 'data' / 'validation.csv')\n",
    "dec_df = data_loader.load_december_data(BASE_DIR / 'data' / 'december-chart-inputs.csv')\n",
    "\n",
    "print(f'Train Shape: {train_df.shape}')\n",
    "print(f'Validation Shape: {val_df.shape}')\n",
    "print(f'December Inputs Shape: {dec_df.shape}')\n",
    "\n",
    "train_df.head(5)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Target Variable Analysis (`posted_rate`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(train_df['posted_rate'].describe())\n",
    "\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.hist(train_df['posted_rate'], bins=50, color='#064A56', edgecolor='white', alpha=0.8)\n",
    "plt.title('Distribution of Posted Freight Rates ($)')\n",
    "plt.xlabel('Posted Rate ($)')\n",
    "plt.ylabel('Frequency')\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Rate per Mile & Distance Interactions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "train_df['rate_per_mile'] = train_df['posted_rate'] / train_df['distance']\n",
    "train_df['base_signal'] = train_df['distance'] * train_df['quote_signal']\n",
    "\n",
    "print('Rate per Mile summary:')\n",
    "print(train_df['rate_per_mile'].describe())\n",
    "\n",
    "print('\\nEquipment Rate per Mile Comparison:')\n",
    "print(train_df.groupby('equipment')['rate_per_mile'].describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Multiplicative Signal Interaction (`base_signal` vs `posted_rate`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "corr = train_df['base_signal'].corr(train_df['posted_rate'])\n",
    "print(f'Correlation between base_signal (distance * quote_signal) and posted_rate: {corr:.4f}')\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.scatter(train_df['base_signal'], train_df['posted_rate'], alpha=0.2, color='#064A56', s=10)\n",
    "plt.plot([0, 25000], [0, 25000], 'r--', label='1:1 Line')\n",
    "plt.title('Base Multiplicative Signal vs Actual Posted Rate')\n",
    "plt.xlabel('Base Signal = Distance * Quote Signal ($)')\n",
    "plt.ylabel('Actual Posted Rate ($)')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Temporal Trends & Seasonality"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "train_df['month'] = train_df['date'].dt.month\n",
    "monthly = train_df.groupby('month').agg(\n",
    "    mean_rate=('posted_rate', 'mean'),\n",
    "    mean_rpm=('rate_per_mile', 'mean'),\n",
    "    mean_mkt=('market_index', 'mean')\n",
    ").reset_index()\n",
    "\n",
    "print(monthly)\n",
    "\n",
    "plt.figure(figsize=(9, 4))\n",
    "plt.plot(monthly['month'], monthly['mean_rpm'], marker='o', color='#064A56', linewidth=2)\n",
    "plt.title('Average Rate per Mile by Month (Jan - Oct 2025)')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Mean Rate per Mile ($/mi)')\n",
    "plt.grid(True, linestyle='--', alpha=0.5)\n",
    "plt.show()"
   ]
  }
 ],
